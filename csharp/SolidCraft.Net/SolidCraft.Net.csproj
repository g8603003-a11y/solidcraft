<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SolidCraft</RootNamespace>
    <AssemblyName>SolidCraft.Net</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>0.1.0</Version>
    <Description>.NET client for the SolidCraft desktop app's control channel: run modelling commands, read the design, follow changes.</Description>
  </PropertyGroup>

</Project>
